# ===============================================
# AutoTest AI - Environment Configuration
# ===============================================

# ===============================================
# DATABASE CONFIGURATION
# ===============================================

# PostgreSQL (Production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme123_use_strong_password
POSTGRES_DB=autotest_prod
DATABASE_URL=postgresql://postgres:changeme123_use_strong_password@postgres:5432/autotest_prod

# SQLite (Development - Default)
# DATABASE_URL=sqlite:///./autotest.db

# ===============================================
# SECURITY & AUTHENTICATION
# ===============================================

# Secret keys for JWT and session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-min-32-characters-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===============================================
# AI CONFIGURATION
# ===============================================

# OpenAI API (Primary AI provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Ollama (Optional - for local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# LangChain
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=

# ===============================================
# EMAIL CONFIGURATION (SMTP)
# ===============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=noreply@autotest.ai
SMTP_FROM_NAME=AutoTest AI
SMTP_ENABLED=true
SMTP_TLS=true

# ===============================================
# GITHUB INTEGRATION
# ===============================================

# GitHub Personal Access Token
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-for-validation

# ===============================================
# SLACK INTEGRATION (Optional)
# ===============================================

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#testing
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ===============================================
# DISCORD INTEGRATION (Optional)
# ===============================================

DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ===============================================
# MICROSOFT TEAMS INTEGRATION (Optional)
# ===============================================

TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# ===============================================
# FRONTEND CONFIGURATION
# ===============================================

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment
NODE_ENV=production

# ===============================================
# APPLICATION CONFIGURATION
# ===============================================

# Application settings
APP_NAME=AutoTest AI
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# File upload limits (in MB)
MAX_UPLOAD_SIZE=50
MAX_FILE_SIZE_MB=50

# Test execution settings
MAX_CONCURRENT_TESTS=5
TEST_TIMEOUT_SECONDS=300
SCREENSHOT_ON_FAILURE=true

# ===============================================
# PLAYWRIGHT CONFIGURATION
# ===============================================

PLAYWRIGHT_BROWSERS=chromium,firefox,webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SCREENSHOT_PATH=./uploads/screenshots

# ===============================================
# VISUAL TESTING CONFIGURATION
# ===============================================

VISUAL_TEST_THRESHOLD=0.1
VISUAL_TEST_IGNORE_ANTIALIASING=true
VISUAL_TEST_IGNORE_COLORS=false
VISUAL_DIFF_METHOD=pixelmatch

# ===============================================
# LOGGING CONFIGURATION
# ===============================================

LOG_LEVEL=info
LOG_FILE=./logs/autotest.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_FORMAT=json

# ===============================================
# REDIS CONFIGURATION (Optional - for caching)
# ===============================================

REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ===============================================
# MONITORING & ANALYTICS (Optional)
# ===============================================

# Sentry (Error tracking)
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
GA_TRACKING_ID=

# Mixpanel
MIXPANEL_TOKEN=

# ===============================================
# CORS CONFIGURATION
# ===============================================

CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ===============================================
# RATE LIMITING
# ===============================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===============================================
# BACKUP CONFIGURATION
# ===============================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ===============================================
# SECURITY HEADERS
# ===============================================

SECURE_COOKIES=true
HSTS_ENABLED=true
CSP_ENABLED=true

# ===============================================
# WEBHOOK CONFIGURATION
# ===============================================

WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=10

# ===============================================
# CI/CD CONFIGURATION
# ===============================================

# GitHub Actions
GITHUB_ACTIONS_ENABLED=true

# GitLab CI
GITLAB_CI_ENABLED=false
GITLAB_TOKEN=

# Jenkins
JENKINS_ENABLED=false
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ===============================================
# CLOUD STORAGE (Optional)
# ===============================================

# AWS S3
S3_ENABLED=false
S3_BUCKET=autotest-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Azure Blob Storage
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=autotest-uploads

# Google Cloud Storage
GCS_ENABLED=false
GCS_BUCKET=autotest-uploads
GCS_PROJECT_ID=
GCS_CREDENTIALS_PATH=./gcs-credentials.json

# ===============================================
# NOTIFICATION SETTINGS
# ===============================================

# Notification preferences
NOTIFY_ON_TEST_SUCCESS=false
NOTIFY_ON_TEST_FAILURE=true
NOTIFY_ON_BUG_CREATED=true
NOTIFY_ON_REGRESSION_DETECTED=true
NOTIFY_ON_CICD_FAILURE=true

# ===============================================
# FEATURE FLAGS
# ===============================================

FEATURE_VISUAL_TESTING=true
FEATURE_SELF_HEALING=true
FEATURE_AI_CHAT=true
FEATURE_CICD_INTEGRATION=true
FEATURE_REGRESSION_TESTING=true
FEATURE_BUG_TRACKING=true
FEATURE_REPORT_GENERATION=true

# ===============================================
# NOTES
# ===============================================
# 
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords for production
# 3. Generate secret keys with: 
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. For Gmail SMTP, use App Passwords:
#    https://support.google.com/accounts/answer/185833
# 5. GitHub token requires: repo, workflow, read:org scopes
# 6. Update NEXT_PUBLIC_API_URL to your domain in production
#
# ===============================================
